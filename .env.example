POSTGRES_USER=tasks
POSTGRES_PASSWORD=tasks
POSTGRES_DB=tasks

# Leave DATABASE_URL empty for local `uvicorn` (in-memory tasks).
# docker compose sets DATABASE_URL for the app container automatically.
DATABASE_URL=

# Supabase Auth (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
PORT=8000


